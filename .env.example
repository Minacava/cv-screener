# === CONFIGURACIÓN RECOMENDADA PARA PRODUCCIÓN ===
# Gemini: confiable, rápido, gratuito dentro de cuota
# Pollinations: imágenes gratuitas sin cuota (fallback automático)
# OpenRouter: opcional solo para chat/RAG

# Google Gemini (REQUERIDO para CV generation + embeddings)
GEMINI_API_KEY=

# OpenRouter (OPCIONAL - solo para chat/RAG en la UI)
OPENROUTER_API_KEY=

# Pinecone (REQUERIDO para RAG)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=cv-screener

# === Configuración ÓPTIMA para entrevista ===
# CV Text Generation: Gemini 3.6 Flash (confiable, rápido ~100s/25 CVs)
GEMINI_CV_GEN_MODEL=gemini-3.6-flash

# CV Images: Gemini 3.1 Flash Image (gratis dentro de cuota)
# Si excede cuota, automáticamente usa Pollinations como fallback
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Embeddings: Gemini text-embedding-004 (768 dims, excelente para búsqueda semántica)
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Chat/RAG: OpenRouter Inkling Small (mejor para RAG) o Gemini como fallback
OPENROUTER_CHAT_MODEL=thinkingmachines/inkling-small:free

# === NO USAR OpenRouter para CV generation ===
# OpenRouter free tier no es confiable (se cuelga indefinidamente)
# Estos valores están comentados intencionalmente:
# OPENROUTER_CV_GEN_MODEL=
# OPENROUTER_CV_GEN_MODELS=

# === Control de Imágenes ===
# Comentar SKIP_GEMINI_IMAGE para ACTIVAR imágenes (requerido por la tarea técnica)
# SKIP_GEMINI_IMAGE=1
# 
# Si Gemini falla, Pollinations se usa automáticamente como fallback
