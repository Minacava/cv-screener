# Required — CV generation + embeddings
GEMINI_API_KEY=

# Required — vector store
PINECONE_API_KEY=
PINECONE_INDEX_NAME=cv-screener

# Optional — chat / RAG via OpenRouter
OPENROUTER_API_KEY=

# Models
GEMINI_CV_GEN_MODEL=gemini-flash-lite-latest
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENROUTER_CHAT_MODEL=thinkingmachines/inkling-small:free

# Optional — set to 1 to skip Gemini images (Pollinations / placeholder still used)
# SKIP_GEMINI_IMAGE=1

# Optional — clear Pinecone namespace "cvs" before reindexing
# RESET_PINECONE=1
